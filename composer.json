{
    "name": "datascouting/unimarc2marc21",
    "description": "Z39.50 fetch, Unimarc to Marc21 transformation and Koha upload",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "ext-curl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Unimarc2Marc21\\": "www/app/php/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Unimarc2Marc21\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.5.12"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
